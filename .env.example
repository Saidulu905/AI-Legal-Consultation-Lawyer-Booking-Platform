# Local development — copy to .env and fill in values
# On Render, these are set automatically via render.yaml

# Database (local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=legal_platform
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Or use Spring-style names directly:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/legal_platform?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Backend
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key
PORT=8080

# Frontend (used at build time for Vite)
VITE_API_BASE_URL=http://localhost:8080

# Render sets DATABASE_URL automatically when you link the PostgreSQL database.
