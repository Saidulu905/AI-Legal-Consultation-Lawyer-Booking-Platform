# Local development — copy to .env and fill in values
# On Render, these are set automatically via render.yaml

# Database (local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legal_platform
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Or use Spring-style names directly:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/legal_platform
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# Backend
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=your-gemini-api-key
PORT=8080

# Frontend (used at build time for Vite)
VITE_API_BASE_URL=http://localhost:8080

# Render sets DATABASE_URL automatically when you link the PostgreSQL database.
